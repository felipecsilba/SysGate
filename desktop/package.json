{
  "name": "krakion-desktop",
  "productName": "Krakion App",
  "version": "0.1.0",
  "description": "Krakion Desktop — app local e offline do implantador",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,app -c magenta,cyan \"vite\" \"node electron/abrir.js\"",
