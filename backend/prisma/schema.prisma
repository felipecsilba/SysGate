generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Sistema {
  id                Int                @id @default(autoincrement())
  nome              String
  urlBase           String
  descricao         String?
  criadoEm         DateTime           @default(now())
  endpoints         Endpoint[]
  swaggerSpecs      SwaggerSpec[]
  municipioSistemas MunicipioSistema[]
  requisicoes       Requisicao[]
}

model Municipio {
  id                Int                @id @default(autoincrement())
  nome              String
  observacoes       String?
  ativo             Boolean            @default(false)
  usuarioId         Int?
  usuario           Usuario?           @relation(fields: [usuarioId], references: [id])
  criadoEm         DateTime           @default(now())
  atualizadoEm     DateTime           @updatedAt
  requisicoes       Requisicao[]
  scripts           Script[]
  relatorios        Relatorio[]
  municipioSistemas MunicipioSistema[]
}

model MunicipioSistema {
  id              Int       @id @default(autoincrement())
  municipioId     Int
  sistemaId       Int
  token           String
  ambiente        String    @default("producao")
  dataVencimento  DateTime?
  municipio       Municipio @relation(fields: [municipioId], references: [id], onDelete: Cascade)
  sistema         Sistema   @relation(fields: [sistemaId], references: [id], onDelete: Cascade)

  @@unique([municipioId, sistemaId])
}

model Endpoint {
  id          Int          @id @default(autoincrement())
  modulo      String
  nome        String
  path        String
  metodo      String       // GET | POST | PUT | PATCH | DELETE
  descricao   String?
  bodySchema  String?      // JSON serializado com os campos do body
  sistemaId   Int?
  sistema     Sistema?     @relation(fields: [sistemaId], references: [id], onDelete: SetNull)
  criadoEm   DateTime     @default(now())
  requisicoes  Requisicao[]
}

model Requisicao {
  id          Int        @id @default(autoincrement())
  municipioId Int
  sistemaId   Int?
  endpointId  Int?
  metodo      String
  url         String
  headers     String?    // JSON serializado
  body        String?    // JSON serializado
  statusCode  Int?
  resposta    String?    // JSON serializado
  duracaoMs   Int?
  tipo        String?    // "individual" | "lote"
  idGerado    String?    // ID gerado pela API na resposta
  criadoEm   DateTime   @default(now())
  municipio   Municipio  @relation(fields: [municipioId], references: [id])
  sistema     Sistema?   @relation(fields: [sistemaId], references: [id], onDelete: SetNull)
  endpoint    Endpoint?  @relation(fields: [endpointId], references: [id], onDelete: SetNull)

  @@index([municipioId, criadoEm])
}

model Script {
  id           Int         @id @default(autoincrement())
  titulo       String
  conteudo     String
  categoria    String      // "sql" | "comando" | "fonte" | "anotacao"
  municipioId  Int?
  municipio    Municipio?  @relation(fields: [municipioId], references: [id], onDelete: SetNull)
  tags         Tag[]
  criadoEm    DateTime    @default(now())
  atualizadoEm DateTime   @updatedAt

  @@index([categoria])
}

model Tag {
  id         Int         @id @default(autoincrement())
  nome       String      @unique
  scripts    Script[]
  relatorios Relatorio[]
}

model Relatorio {
  id            Int        @id @default(autoincrement())
  titulo        String
  descricao     String?
  jxrmlNome     String?
  jxrmlConteudo String?    // base64 encoded JXRML file
  scriptFonte   String?    // BFC script de fonte dinâmica
  municipioId   Int?
  municipio     Municipio? @relation(fields: [municipioId], references: [id], onDelete: SetNull)
  tags          Tag[]
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
}

model SwaggerSpec {
  id             Int      @id @default(autoincrement())
  nome           String
  versao         String?
  urlBase        String?  // URL base da API descrita no spec
  conteudo       String   // JSON completo da spec (OpenAPI 2/3)
  totalEndpoints Int      @default(0)
  sistemaId      Int?
  sistema        Sistema? @relation(fields: [sistemaId], references: [id], onDelete: SetNull)
  criadoEm      DateTime @default(now())
}

model Usuario {
  id               Int         @id @default(autoincrement())
  login            String      @unique
  senhaHash        String
  nome             String
  role             String      @default("operador")  // "admin" | "operador"
  ativo            Boolean     @default(true)
  tentativasLogin  Int         @default(0)
  bloqueadoAte     DateTime?
  municipios       Municipio[]
  chamadosCriados      Chamado[]           @relation("chamadosCriados")
  chamadosResponsavel  Chamado[]           @relation("chamadosResponsavel")
  comentariosChamado   ChamadoComentario[] @relation("comentariosChamado")
  historicoChamado     ChamadoHistorico[]  @relation("historicoChamado")
  notasProprietario    Nota[]              @relation("NotasProprietario")
  notasCompartilhadas  NotaCompartilhamento[] @relation("NotasCompartilhadas")
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt
}

// ── Módulo Portfólio ─────────────────────────────────────────────────────────

model PortfolioMunicipio {
  id           Int        @id @default(autoincrement())
  nome         String
  estado       String?
  observacoes  String?
  entidades    Entidade[]
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt
}

model Entidade {
  id                   Int                  @id @default(autoincrement())
  nome                 String
  tipo                 String
  observacoes          String?
  portfolioMunicipioId Int
  portfolioMunicipio   PortfolioMunicipio   @relation(fields: [portfolioMunicipioId], references: [id], onDelete: Cascade)
  sistemas             EntidadeSistema[]
  stakeholders         Stakeholder[]
  criadoEm             DateTime             @default(now())
  atualizadoEm         DateTime             @updatedAt
}

model EntidadeSistema {
  id           Int                  @id @default(autoincrement())
  nome         String
  vertical     String?
  ativo        Boolean              @default(true)
  observacoes  String?
  entidadeId   Int
  entidade     Entidade             @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  stakeholders StakeholderSistema[]
  criadoEm     DateTime             @default(now())
  atualizadoEm DateTime             @updatedAt
}

model Stakeholder {
  id                 Int                  @id @default(autoincrement())
  nome               String
  cargo              String?
  telefone           String?
  email              String?
  descricao          String?
  horarioAtendimento String?
  ativo              Boolean              @default(true)
  entidadeId         Int
  entidade           Entidade             @relation(fields: [entidadeId], references: [id], onDelete: Cascade)
  sistemas           StakeholderSistema[]
  criadoEm           DateTime             @default(now())
  atualizadoEm       DateTime             @updatedAt
}

model StakeholderSistema {
  stakeholderId     Int
  entidadeSistemaId Int
  stakeholder       Stakeholder     @relation(fields: [stakeholderId], references: [id], onDelete: Cascade)
  entidadeSistema   EntidadeSistema @relation(fields: [entidadeSistemaId], references: [id], onDelete: Cascade)

  @@id([stakeholderId, entidadeSistemaId])
}

// ── Módulo Chamados ─────────────────────────────────────────────────────────

model Solicitante {
  id        Int       @id @default(autoincrement())
  nome      String
  cargo     String?
  email     String?
  telefone  String?
  municipio String?
  chamados  Chamado[]
  criadoEm  DateTime  @default(now())
}

model Chamado {
  id              Int                @id @default(autoincrement())
  titulo          String
  descricao       String?
  status          String             @default("Nao Analisado")
  classificacao   String?
  prioridade      String             @default("Normal")
  vertical        String?
  sistema         String?
  municipio       String?
  entidade        String?
  solicitanteId   Int?
  solicitante     Solicitante?       @relation(fields: [solicitanteId], references: [id])
  criadoPorId     Int
  criadoPor       Usuario            @relation("chamadosCriados", fields: [criadoPorId], references: [id])
  responsavelId   Int?
  responsavel     Usuario?           @relation("chamadosResponsavel", fields: [responsavelId], references: [id])
  comentarios     ChamadoComentario[]
  anexos          ChamadoAnexo[]
  historicos      ChamadoHistorico[]
  criadoEm        DateTime           @default(now())
  atualizadoEm    DateTime           @updatedAt

  @@index([status, criadoEm])
  @@index([responsavelId])
  @@index([vertical])
}

model ChamadoComentario {
  id          Int      @id @default(autoincrement())
  conteudo    String
  chamadoId   Int
  chamado     Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  autorId     Int
  autor       Usuario  @relation("comentariosChamado", fields: [autorId], references: [id])
  criadoEm    DateTime @default(now())
}

model ChamadoAnexo {
  id           Int      @id @default(autoincrement())
  nomeArquivo  String
  tipo         String?
  conteudo     String
  tamanho      Int?
  chamadoId    Int
  chamado      Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  comentarioId Int?     // Vincula imagem a comentário específico (para exibição inline)
  criadoEm     DateTime @default(now())
}

model ChamadoHistorico {
  id          Int      @id @default(autoincrement())
  chamadoId   Int
  chamado     Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  usuarioId   Int
  usuario     Usuario  @relation("historicoChamado", fields: [usuarioId], references: [id])
  tipo        String   // "criacao" | "status" | "responsavel" | "classificacao" | "prioridade" | "titulo"
  valorAntes  String?
  valorDepois String?
  criadoEm    DateTime @default(now())
}

// ── Módulo Notas ─────────────────────────────────────────────────────────────

model Nota {
  id            Int       @id @default(autoincrement())
  titulo        String    @default("Sem título")
  tipo          String    @default("texto")   // texto | checklist | lista | codigo
  conteudo      String    @default("")        // usado por tipo "texto" e "codigo"
  itens         String    @default("[]")      // JSON: [{texto: string, feito?: boolean}]
  cor           String    @default("#FFFDE7")
  fixada        Boolean   @default(false)
  ordem         Int       @default(0)
  etiquetas     String    @default("[]")      // JSON: string[]
  usuarioId     Int
  usuario       Usuario   @relation("NotasProprietario", fields: [usuarioId], references: [id])
  compartilhamentos NotaCompartilhamento[]
  criadoEm      DateTime  @default(now())
  atualizadoEm  DateTime  @updatedAt

  @@index([usuarioId, ordem])
}

model NotaCompartilhamento {
  id        Int      @id @default(autoincrement())
  notaId    Int
  nota      Nota     @relation(fields: [notaId], references: [id], onDelete: Cascade)
  usuarioId Int
  usuario   Usuario  @relation("NotasCompartilhadas", fields: [usuarioId], references: [id])
  criadoEm  DateTime @default(now())

  @@unique([notaId, usuarioId])
}

model CatalogoVertical {
  id           Int      @id @default(autoincrement())
  nome         String   @unique
  cor          String   @default("#94A3B8")
  sistemas     String   @default("[]")
  ordem        Int      @default(0)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}
